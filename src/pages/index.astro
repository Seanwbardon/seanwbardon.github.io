---
import Layout from '../layouts/Layout.astro';
import { profile, education, experience, projects, skills, extras } from '../data/profile';
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Hi, I'm</p>
      <h1>{profile.name}</h1>
      <p class="role">{profile.title}</p>
      <p class="lead">{profile.tagline}</p>
      <div class="hero-actions">
        <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" viewBox="0 0 16 16" width="18" height="18"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          View my GitHub
        </a>
        <a class="btn btn-ghost" href={`mailto:${profile.email}`}>Get in touch</a>
      </div>
    </div>
  </section>

  <!-- ABOUT / EDUCATION -->
  <section id="about" class="section">
    <div class="container grid-2">
      <div>
        <h2 class="section-title">About me</h2>
        <p>{profile.summary}</p>
        <p class="muted">📍 {profile.location}</p>
      </div>
      <div class="card">
        <p class="card-kicker">Education</p>
        <h3>{education.degree}</h3>
        <p class="muted">{education.institution} · {education.dates}</p>
        <p class="highlight">{education.result}</p>
        <ul class="chips">
          {education.modules.map((m) => <li class="chip chip-soft">{m}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="section section-alt">
    <div class="container">
      <h2 class="section-title">Experience</h2>
      <ol class="timeline">
        {experience.map((job) => (
          <li class="timeline-item">
            <div class="timeline-head">
              <span class={`tag tag-${job.tag.toLowerCase()}`}>{job.tag}</span>
              {job.dates && <span class="muted">{job.dates}</span>}
            </div>
            <h3>{job.role}</h3>
            <p class="org">{job.org}{job.place && ` · ${job.place}`}</p>
            <ul class="bullets">
              {job.points.map((p) => <li>{p}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="section">
    <div class="container">
      <h2 class="section-title">Projects</h2>
      <div class="project-grid">
        {projects.map((p) => (
          <article class="card project">
            <p class="card-kicker">{p.kind}</p>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <ul class="chips">
              {p.tech.map((t) => <li class="chip">{t}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="section section-alt">
    <div class="container">
      <h2 class="section-title">Skills, languages &amp; frameworks</h2>
      <div class="skills-grid">
        {Object.entries(skills).map(([group, items]) => (
          <div class="card">
            <h3>{group}</h3>
            <ul class="chips">
              {items.map((s) => <li class="chip">{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="extras">
        <h3>Awards &amp; activities</h3>
        <ul class="chips">
          {extras.map((e) => <li class="chip chip-soft">{e}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- GITHUB CTA -->
  <section class="section cta">
    <div class="container cta-inner">
      <h2>See the code behind the projects</h2>
      <p>Repositories, commit history and READMEs for my coursework and personal builds.</p>
      <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">
        github.com/{profile.githubHandle}
      </a>
    </div>
  </section>
</Layout>
